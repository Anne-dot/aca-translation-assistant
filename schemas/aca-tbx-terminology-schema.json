{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Anne-dot/aca-translation-assistant/schemas/aca-tbx-terminology-schema.json",
  "title": "ACA Terminology Database Schema (internal master, TBX-Basic exportable)",
  "description": "JSON Schema for the ACA Translation Assistant terminology database. Internal format, exportable to TBX-Basic Version 4 (2025). Authoritative field reference: research/standards/JSON_SCHEMA_SPECIFICATION.md v2.0. Derived values (multiword-ness, component word lists, TBX export status) are computed, never stored. Note: the EN-section requirement and referential-integrity rules live in the Python validator (JSON Schema cannot express them); see spec Section 7.",
  "version": "2.0.0",
  "type": "object",
  "required": ["metadata", "concepts"],
  "additionalProperties": false,

  "properties": {
    "metadata": {
      "type": "object",
      "required": ["created", "standard", "formatVersion", "author", "license"],
      "additionalProperties": false,
      "properties": {
        "created": {
          "type": "string",
          "format": "date",
          "description": "Database creation date (YYYY-MM-DD)"
        },
        "standard": {
          "type": "string",
          "const": "Internal format, exportable to TBX-Basic Version 4 (2025)",
          "description": "Relationship to the terminology exchange standard"
        },
        "formatVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "description": "Format version (major.minor); this schema describes 2.0"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "description": "Database author/maintainer"
        },
        "project": {
          "type": "string",
          "description": "Project name (OPTIONAL)"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "description": "License information (CC BY-SA 4.0)"
        }
      }
    },

    "concepts": {
      "type": "array",
      "minItems": 1,
      "description": "Array of terminology concepts",
      "items": {
        "$ref": "#/definitions/concept"
      }
    }
  },

  "definitions": {
    "concept": {
      "type": "object",
      "required": ["id", "subjectField", "languages", "_metadata"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^aca-\\d{4}$",
          "description": "Unique concept identifier (format: aca-0001)"
        },
        "subjectField": {
          "type": "string",
          "const": "ACA terminology",
          "description": "Subject field classification (domain, not origin category)"
        },
        "languages": {
          "type": "object",
          "minProperties": 1,
          "description": "Language sections (key = ISO 639-1 code). EN required by the Python validator (warning-only for communityAdded concepts - open question, spec Section 10).",
          "patternProperties": {
            "^[a-z]{2}$": {
              "$ref": "#/definitions/languageSection"
            }
          },
          "additionalProperties": false
        },
        "_metadata": {
          "$ref": "#/definitions/conceptMetadata"
        }
      }
    },

    "languageSection": {
      "type": "object",
      "required": ["xml:lang", "terms"],
      "additionalProperties": false,
      "properties": {
        "xml:lang": {
          "type": "string",
          "pattern": "^[a-z]{2}$",
          "description": "ISO 639-1 language code; must equal the containing key (Python validator checks equality)"
        },
        "definition": {
          "type": "string",
          "minLength": 10,
          "description": "Language-specific definition (OPTIONAL, recommended). Exported at language level (descrip type=definition)."
        },
        "terms": {
          "type": "array",
          "minItems": 1,
          "description": "Array of terms in this language",
          "items": {
            "$ref": "#/definitions/term"
          }
        }
      }
    },

    "term": {
      "type": "object",
      "required": ["term", "source", "transactions"],
      "additionalProperties": false,
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1,
          "description": "The term text (base form / lemma)"
        },
        "termType": {
          "type": ["string", "null"],
          "enum": ["fullForm", "acronym", "abbreviation", "shortForm", "variant", "phrase", null],
          "description": "TBX-Basic V4 term type (form axis; 'phrase' marks fixed expressions/idioms/sayings)"
        },
        "partOfSpeech": {
          "type": ["string", "null"],
          "enum": ["noun", "verb", "adjective", "adverb", "properNoun", "other", null],
          "description": "Part of speech, TBX-Basic V4 picklist (grammar axis; no 'phrase' value). OPTIONAL until the quality gate; export refuses terms without it (V4 par. 9)."
        },
        "supersededBy": {
          "type": "string",
          "minLength": 1,
          "description": "Term text of the replacement within the same language section (exports as deprecated + crossReference). Text-vs-ID referencing is an open decision (spec Section 10)."
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "Explanations, register info, usage guidance. Never duplicates a status (spec Principle 5)."
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "workflow": {
          "$ref": "#/definitions/workflow"
        },
        "usageExamples": {
          "type": "array",
          "description": "Usage examples from WSO source texts",
          "items": {
            "$ref": "#/definitions/usageExample"
          }
        },
        "transactions": {
          "type": "array",
          "minItems": 1,
          "description": "Full transaction history (audit trail)",
          "items": {
            "$ref": "#/definitions/transaction"
          }
        }
      }
    },

    "source": {
      "type": "object",
      "required": ["type", "title", "addedBy", "date"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["book", "dictionary", "website", "manual_addition", "conference", "transcription"],
          "description": "Source type"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Source name/title"
        },
        "addedBy": {
          "type": "string",
          "minLength": 1,
          "description": "Who added this entry (auto-generated from logged-in user)"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "When added (YYYY-MM-DD, auto-generated)"
        },
        "chapter": {
          "type": "string",
          "description": "Chapter number/name (OPTIONAL, books)"
        },
        "page": {
          "type": ["string", "integer"],
          "description": "Page number/range, or MM-DD for daily meditation books (OPTIONAL)"
        },
        "edition": {
          "type": "string",
          "description": "Edition (OPTIONAL, books)"
        },
        "isbn": {
          "type": "string",
          "description": "ISBN (OPTIONAL, books)"
        },
        "publisher": {
          "type": "string",
          "description": "Publisher (OPTIONAL, books)"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Source URL (OPTIONAL; auto for script lookups)"
        },
        "note": {
          "type": "string",
          "description": "Additional context (OPTIONAL)"
        }
      }
    },

    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "description": "The community's status truth (single source of truth). The TBX export status is DERIVED from this at export time and never stored.",
      "properties": {
        "communityReviewStatus": {
          "type": "string",
          "enum": ["candidate", "approved", "rejected"],
          "description": "Community review decision (de jure)"
        },
        "communityTextUsage": {
          "type": "string",
          "enum": ["in_use", "not_in_use", "formerly_in_use"],
          "description": "Actual usage in community texts (de facto); never affects the derived export status; JSON-only (not exported)"
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1,
          "description": "REQUIRED when communityReviewStatus = approved"
        },
        "approvedDate": {
          "type": "string",
          "format": "date",
          "description": "REQUIRED when communityReviewStatus = approved"
        },
        "rejectedBy": {
          "type": "string",
          "minLength": 1,
          "description": "REQUIRED when communityReviewStatus = rejected"
        },
        "rejectedDate": {
          "type": "string",
          "format": "date",
          "description": "REQUIRED when communityReviewStatus = rejected"
        },
        "rejectedReason": {
          "type": "string",
          "description": "Why rejected (OPTIONAL; exports as a term-level note)"
        },
        "firstUsedDate": {
          "type": "string",
          "format": "date",
          "description": "When first used in community texts (OPTIONAL)"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "communityReviewStatus": { "const": "approved" } },
            "required": ["communityReviewStatus"]
          },
          "then": {
            "required": ["approvedBy", "approvedDate"]
          }
        },
        {
          "if": {
            "properties": { "communityReviewStatus": { "const": "rejected" } },
            "required": ["communityReviewStatus"]
          },
          "then": {
            "required": ["rejectedBy", "rejectedDate"]
          }
        }
      ]
    },

    "usageExample": {
      "type": "object",
      "required": ["source", "enContext", "etTranslation"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/definitions/source",
          "description": "Where the example comes from (WSO materials only)"
        },
        "enContext": {
          "type": "string",
          "minLength": 10,
          "description": "English context sentence (exports as descrip type=context on the EN term)"
        },
        "etTranslation": {
          "type": "string",
          "minLength": 10,
          "description": "Estonian translation of the context (exports as descrip type=context on the ET term)"
        },
        "translatorNote": {
          "type": "object",
          "additionalProperties": false,
          "description": "Translation-decision documentation (JSON-only; never exported)",
          "properties": {
            "author": { "type": "string" },
            "date": { "type": "string", "format": "date" },
            "explanation": { "type": "string" },
            "keyInsight": { "type": "string" }
          }
        }
      }
    },

    "transaction": {
      "type": "object",
      "required": ["type", "actionType", "responsibility", "date"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["origination", "modification"],
          "description": "Transaction type ('origination' exports as TBX-Basic V4 'creation')"
        },
        "actionType": {
          "type": "string",
          "enum": ["originated", "enriched", "approved", "rejected", "modified", "manual_addition"],
          "description": "Action category for statistics/filtering (JSON-only; not exported)"
        },
        "responsibility": {
          "type": "string",
          "minLength": 1,
          "description": "Person/group/system responsible"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Transaction date (YYYY-MM-DD, auto-generated)"
        },
        "actionDescription": {
          "type": "string",
          "description": "Free-text description of what happened (OPTIONAL; JSON-only)"
        },
        "statusChange": {
          "type": "string",
          "description": "Status transition, e.g. 'candidate → approved' (OPTIONAL; JSON-only)"
        }
      }
    },

    "conceptMetadata": {
      "type": "object",
      "required": ["isGlossaryTerm", "derivedFrom"],
      "additionalProperties": false,
      "description": "Concept origin metadata (JSON-only; not exported). Removed in 2.0: termComplexity, componentTerms, componentLookups - now computed, never stored.",
      "properties": {
        "isGlossaryTerm": {
          "type": "boolean",
          "description": "True for WSO glossary imports; false for components and community additions"
        },
        "termType": {
          "type": ["string", "null"],
          "enum": ["component", "communityAdded", null],
          "description": "Origin category; REQUIRED (non-null) when isGlossaryTerm is false, null when true"
        },
        "derivedFrom": {
          "type": "array",
          "description": "Parent term texts for component concepts (provenance - original data). Empty for glossary and community terms. Referential integrity checked by the Python validator.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "addedReason": {
          "type": ["string", "null"],
          "description": "REQUIRED (min 20 chars) when termType = communityAdded"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "isGlossaryTerm": { "const": true } },
            "required": ["isGlossaryTerm"]
          },
          "then": {
            "properties": {
              "termType": { "const": null },
              "derivedFrom": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "isGlossaryTerm": { "const": false } },
            "required": ["isGlossaryTerm"]
          },
          "then": {
            "properties": {
              "termType": { "enum": ["component", "communityAdded"] }
            },
            "required": ["termType"]
          }
        },
        {
          "if": {
            "properties": { "termType": { "const": "component" } },
            "required": ["termType"]
          },
          "then": {
            "properties": {
              "derivedFrom": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "termType": { "const": "communityAdded" } },
            "required": ["termType"]
          },
          "then": {
            "properties": {
              "addedReason": { "type": "string", "minLength": 20 }
            },
            "required": ["addedReason"]
          }
        }
      ]
    }
  }
}
